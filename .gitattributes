# Текстовые файлы Unity — с нормализацией переводов строк
*.cs        text diff=csharp
*.asmdef    text
*.json      text
*.yml       text
*.md        text
*.unity     text
*.prefab    text
*.asset     text
*.mat       text
*.meta      text
*.controller text
*.anim      text

